{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "es6",
      "DOM",
      "es2022"
    ],
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "preserveConstEnums": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strictFunctionTypes": true,
    "strict": true,
    "types": [
      "vitest/globals",
      "vite/client",
      "globals",
      "react",
      "react-dom"
    ],
    "paths": {
      "@extra/*": [
        "./src/extra/*"
      ],
      "@core/*": [
        "./src/*"
      ],
      "@generated/*": [
        "./generated/*"
      ]
    }
  },
  "exclude": [
    "__mocks__",
    "dist",
    "build",
    "coverage",
    "node_modules"
  ],
  "include": [
    "src",
    "src/extra/**/*",
    "vite.config.mts",
    "vitest.config.mts",
    "vitest.setup.ts"
  ]
}
